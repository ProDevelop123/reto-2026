# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Puerto HTTP del servicio
PORT=3001

# Nivel de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Tolerancia por defecto para considerar cero un valor flotante al comprobar
# si una matriz es diagonal. Cada peticion puede sobreescribirla.
DIAGONAL_TOLERANCE=1e-9

# --- Seguridad (JWT RS256) -------------------------------------------------
# Esta API solo VERIFICA tokens; nunca los emite. Por eso conoce unicamente la
# clave publica: aunque fuera comprometida, no podria firmar tokens nuevos.

# Poner en false SOLO para pruebas locales con curl. El arranque falla si se
# intenta usar con NODE_ENV=production.
JWT_ENABLED=true

# El emisor es la API en Go, unica poseedora de la clave privada.
JWT_ISSUER=reto-2026-api-go
JWT_AUDIENCE=reto-2026

# Dos formas de entregar la clave publica (la inline tiene prioridad):
#  - JWT_PUBLIC_KEY: el PEM completo o su codificacion en base64. Comodo en
#    plataformas serverless como Cloud Run, donde montar ficheros es incomodo.
#  - JWT_PUBLIC_KEY_PATH: ruta a un fichero .pem. Comodo con docker-compose.
# JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=../keys/public.pem

# --- CORS ------------------------------------------------------------------
# Vacio por defecto: esta API es un servicio interno consumido por la API en Go
# servidor a servidor, donde el navegador no interviene y CORS es irrelevante.
# Lista separada por comas si alguna vez se consume desde un navegador.
CORS_ORIGINS=
