# --- Aplicacion ------------------------------------------------------------
APP_NAME=reto-2026-api-go
# development | production
APP_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=debug

# Limite del cuerpo de la peticion. Una matriz grande es legitima; un cuerpo
# ilimitado es un vector de agotamiento de memoria.
BODY_LIMIT_BYTES=5242880
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s

# --- API de estadisticas (Node.js) -----------------------------------------
# En docker-compose es el nombre del servicio: http://api-node:3001
STATISTICS_API_URL=http://localhost:3001

# Acota CADA INTENTO. Sin timeout, una dependencia colgada retendria goroutines
# indefinidamente y acabaria arrastrando a esta API en su caida.
STATISTICS_TIMEOUT=3s

# Acota la operacion COMPLETA, reintentos incluidos. Sin este techo, la peor
# espera seria STATISTICS_TIMEOUT x (MAX_RETRIES+1) mas las pausas entre
# reintentos, y subir los reintentos empeoraria la latencia en silencio.
STATISTICS_TOTAL_TIMEOUT=8s

# Solo se reintentan fallos transitorios (red y 5xx). Un 4xx significa que la
# peticion es incorrecta y repetirla es inutil.
STATISTICS_MAX_RETRIES=2
STATISTICS_RETRY_BACKOFF=100ms

# --- JWT (RS256) -----------------------------------------------------------
# Esta API es la UNICA que posee la clave privada y, por tanto, la unica capaz
# de emitir tokens. La API en Node solo recibe la publica.
# Generar con:  sh scripts/generate-keys.sh keys
JWT_PRIVATE_KEY_PATH=../keys/private.pem
JWT_PUBLIC_KEY_PATH=../keys/public.pem

# Alternativa para plataformas serverless (Cloud Run), donde montar ficheros es
# incomodo. Admite el PEM completo o su codificacion en base64. Tiene prioridad
# sobre las rutas anteriores.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

JWT_ISSUER=reto-2026-api-go
JWT_AUDIENCE=reto-2026

# Vida corta: el token de acceso viaja en cada peticion y no puede revocarse.
JWT_ACCESS_TTL=15m
# Vida larga: viaja solo al refrescar, en cookie HttpOnly, y SI es revocable.
JWT_REFRESH_TTL=168h

# --- Credenciales del login simulado ---------------------------------------
# El reto no exige gestion de usuarios. El arranque falla si en produccion se
# conserva la contrasena por defecto.
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# --- CORS ------------------------------------------------------------------
# Origenes explicitos, separados por comas. NUNCA "*": la especificacion prohibe
# combinar el comodin con credenciales, y el frontend las necesita para que
# viaje la cookie de refresco.
CORS_ORIGINS=http://localhost:5173

# --- Cookie del refresh token ----------------------------------------------
REFRESH_COOKIE_NAME=refresh_token
# Acotada a las rutas de autenticacion: no se envia a /api/v1/qr, que no la
# necesita. Menos exposicion.
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_DOMAIN=

# ATENCION AL DESPLIEGUE: con el frontend en Vercel y la API en GCP, la peticion
# de refresco es de origen cruzado y el navegador solo enviara la cookie si
# SameSite=None. Y None EXIGE Secure=true, que a su vez exige HTTPS.
# En local, con todo en localhost, Lax basta y funciona sin HTTPS.
# Por defecto: None+Secure en produccion, Lax sin Secure en desarrollo.
# REFRESH_COOKIE_SAMESITE=Lax
# REFRESH_COOKIE_SECURE=false
