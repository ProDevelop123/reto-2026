# Variables del docker-compose. Copiar a .env para sobreescribir los valores
# por defecto:  cp .env.example .env
#
# Todas tienen un valor por defecto en el compose, de modo que
# `docker compose up --build` funciona sin crear este fichero.

# Puerto del host donde se publica la API en Go, el unico punto de entrada.
API_PORT=8080

# Version que se inyecta en el binario al compilar.
VERSION=0.1.0

# --- Credenciales del login simulado ---------------------------------------
# La API en Go se ejecuta con APP_ENV=production tambien en local, para que la
# validacion de configuracion del arranque se ejercite de verdad. Esa
# validacion rechaza la contrasena por defecto del codigo, de ahi que el
# compose defina una distinta.
AUTH_USERNAME=admin
AUTH_PASSWORD=Reto2026.Demo

# --- Origenes permitidos por CORS ------------------------------------------
# Explicitos, nunca comodin: la especificacion prohibe combinar "*" con
# credenciales, y el frontend las necesita para enviar la cookie de refresco.
CORS_ORIGINS=http://localhost:5173

# --- Ajuste fino -----------------------------------------------------------
GO_LOG_LEVEL=info
NODE_LOG_LEVEL=info
DIAGONAL_TOLERANCE=1e-9

# Timeout por intento y techo global de la operacion completa.
STATISTICS_TIMEOUT=3s
STATISTICS_TOTAL_TIMEOUT=8s
STATISTICS_MAX_RETRIES=2

JWT_ISSUER=reto-2026-api-go
JWT_AUDIENCE=reto-2026
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
